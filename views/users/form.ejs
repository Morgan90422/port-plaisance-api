<%- include('../partials/header', { title: editUser ? 'Modifier un utilisateur' : 'Nouvel utilisateur' }) %>

<nav class="dashboard-nav">
  <a href="/dashboard">← Tableau de bord</a>
  <a href="/dashboard/catways">Catways</a>
  <a href="/dashboard/reservations">Réservations</a>
  <a href="/dashboard/users">Utilisateurs</a>
  <a href="/logout" class="logout">Déconnexion</a>
</nav>

<section class="page-card">
  <h1><%= editUser ? 'Modifier l’utilisateur' : 'Nouvel utilisateur' %></h1>

  <% if (error) { %>
    <p class="alert"><%= error %></p>
  <% } %>

  <% const isEdit = editUser && editUser.email; %>

  <form
    action="<%= isEdit ? '/dashboard/users/' + editUser.email + '?_method=PUT' : '/dashboard/users' %>"
    method="POST"
    class="form"
  >
    <label for="username">Nom d'utilisateur</label>
    <input type="text" id="username" name="username" value="<%= editUser ? editUser.username : '' %>" required>

    <label for="email">Email</label>
    <input type="email" id="email" name="email" value="<%= editUser ? editUser.email : '' %>" required>

    <label for="password">Mot de passe <%= isEdit ? '(laisser vide pour ne pas changer)' : '' %></label>
    <input type="password" id="password" name="password" <%= isEdit ? '' : 'required' %> minlength="6">

    <button type="submit"><%= isEdit ? 'Enregistrer' : 'Créer' %></button>
  </form>

  <p><a href="/dashboard/users">← Retour à la liste</a></p>
</section>

<%- include('../partials/footer') %>
