<%- include('../partials/header', { title: 'Utilisateurs' }) %>

<nav class="dashboard-nav">
  <a href="/dashboard">← Tableau de bord</a>
  <a href="/dashboard/catways">Catways</a>
  <a href="/dashboard/reservations">Réservations</a>
  <a href="/dashboard/users">Utilisateurs</a>
  <a href="/logout" class="logout">Déconnexion</a>
</nav>

<section class="page-card">
  <div class="page-header">
    <h1>Utilisateurs</h1>
    <a href="/dashboard/users/new" class="btn">+ Nouvel utilisateur</a>
  </div>

  <table>
    <thead>
      <tr>
        <th>Nom d'utilisateur</th>
        <th>Email</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% users.forEach(u => { %>
        <tr>
          <td><%= u.username %></td>
          <td><%= u.email %></td>
          <td class="actions">
            <a href="/dashboard/users/<%= u.email %>">Modifier</a>
            <form action="/dashboard/users/<%= u.email %>?_method=DELETE" method="POST" onsubmit="return confirm('Supprimer cet utilisateur ?');">
              <button type="submit" class="btn-danger">Supprimer</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>

<%- include('../partials/footer') %>
