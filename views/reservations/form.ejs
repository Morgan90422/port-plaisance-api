<%- include('../partials/header', { title: reservation ? 'Modifier une réservation' : 'Nouvelle réservation' }) %>
<%- include('../partials/helpers') %>

<nav class="dashboard-nav">
  <a href="/dashboard">← Tableau de bord</a>
  <a href="/dashboard/catways">Catways</a>
  <a href="/dashboard/reservations">Réservations</a>
  <a href="/dashboard/users">Utilisateurs</a>
  <a href="/logout" class="logout">Déconnexion</a>
</nav>

<section class="page-card">
  <h1><%= reservation && reservation._id ? 'Modifier la réservation' : 'Nouvelle réservation' %></h1>

  <% if (error) { %>
    <p class="alert"><%= error %></p>
  <% } %>

  <% const isEdit = reservation && reservation._id; %>

  <form
    action="<%= isEdit ? '/dashboard/reservations/' + reservation._id + '?_method=PUT' : '/dashboard/reservations' %>"
    method="POST"
    class="form"
  >
    <label for="catwayNumber">Catway</label>
    <select id="catwayNumber" name="catwayNumber" required>
      <% catways.forEach(c => { %>
        <option
          value="<%= c.catwayNumber %>"
          <%= reservation && Number(reservation.catwayNumber) === c.catwayNumber ? 'selected' : '' %>
        >
          n°<%= c.catwayNumber %> (<%= c.catwayType %>)
        </option>
      <% }) %>
    </select>

    <label for="clientName">Nom du client</label>
    <input type="text" id="clientName" name="clientName" value="<%= reservation ? reservation.clientName : '' %>" required>

    <label for="boatName">Nom du bateau</label>
    <input type="text" id="boatName" name="boatName" value="<%= reservation ? reservation.boatName : '' %>" required>

    <label for="startDate">Date de début</label>
    <input type="date" id="startDate" name="startDate" value="<%= reservation ? toDateInput(reservation.startDate) : '' %>" required>

    <label for="endDate">Date de fin</label>
    <input type="date" id="endDate" name="endDate" value="<%= reservation ? toDateInput(reservation.endDate) : '' %>" required>

    <button type="submit"><%= isEdit ? 'Enregistrer' : 'Créer' %></button>
  </form>

  <p><a href="/dashboard/reservations">← Retour à la liste</a></p>
</section>

<%- include('../partials/footer') %>
