<%- include('../partials/header', { title: 'Réservations' }) %>

<nav class="dashboard-nav">
  <a href="/dashboard">← Tableau de bord</a>
  <a href="/dashboard/catways">Catways</a>
  <a href="/dashboard/reservations">Réservations</a>
  <a href="/dashboard/users">Utilisateurs</a>
  <a href="/logout" class="logout">Déconnexion</a>
</nav>

<section class="page-card">
  <div class="page-header">
    <h1>Réservations</h1>
    <a href="/dashboard/reservations/new" class="btn">+ Nouvelle réservation</a>
  </div>

  <table>
    <thead>
      <tr>
        <th>Catway</th>
        <th>Client</th>
        <th>Bateau</th>
        <th>Début</th>
        <th>Fin</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% reservations.forEach(r => { %>
        <tr>
          <td><%= r.catwayNumber %></td>
          <td><%= r.clientName %></td>
          <td><%= r.boatName %></td>
          <td><%= new Date(r.startDate).toLocaleDateString('fr-FR') %></td>
          <td><%= new Date(r.endDate).toLocaleDateString('fr-FR') %></td>
          <td class="actions">
            <a href="/dashboard/reservations/<%= r._id %>">Modifier</a>
            <form action="/dashboard/reservations/<%= r._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Supprimer cette réservation ?');">
              <button type="submit" class="btn-danger">Supprimer</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>

<%- include('../partials/footer') %>
