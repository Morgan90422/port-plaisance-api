<%- include('../partials/header', { title: 'Catways' }) %>

<nav class="dashboard-nav">
  <a href="/dashboard">← Tableau de bord</a>
  <a href="/dashboard/catways">Catways</a>
  <a href="/dashboard/reservations">Réservations</a>
  <a href="/dashboard/users">Utilisateurs</a>
  <a href="/logout" class="logout">Déconnexion</a>
</nav>

<section class="page-card">
  <div class="page-header">
    <h1>Catways</h1>
    <a href="/dashboard/catways/new" class="btn">+ Nouveau catway</a>
  </div>

  <table>
    <thead>
      <tr>
        <th>Numéro</th>
        <th>Type</th>
        <th>État</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% catways.forEach(c => { %>
        <tr>
          <td><%= c.catwayNumber %></td>
          <td><%= c.catwayType %></td>
          <td><%= c.catwayState %></td>
          <td class="actions">
            <a href="/dashboard/catways/<%= c.catwayNumber %>">Modifier</a>
            <form action="/dashboard/catways/<%= c.catwayNumber %>?_method=DELETE" method="POST" onsubmit="return confirm('Supprimer ce catway ?');">
              <button type="submit" class="btn-danger">Supprimer</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>

<%- include('../partials/footer') %>
