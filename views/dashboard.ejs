<%- include('partials/header', { title: 'Tableau de bord' }) %>

<nav class="dashboard-nav">
  <a href="/dashboard/catways">Catways</a>
  <a href="/dashboard/reservations">Réservations</a>
  <a href="/dashboard/users">Utilisateurs</a>
  <a href="/api-docs">Documentation API</a>
  <a href="/logout" class="logout">Déconnexion</a>
</nav>

<section class="user-card">
  <p><strong>Connecté en tant que :</strong> <%= user.username %> (<%= user.email %>)</p>
  <p><strong>Date du jour :</strong> <%= today.toLocaleDateString('fr-FR', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></p>
</section>

<section class="reservations-table">
  <h2>Réservations en cours</h2>

  <% if (reservations.length === 0) { %>
    <p>Aucune réservation en cours actuellement.</p>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Catway</th>
          <th>Client</th>
          <th>Bateau</th>
          <th>Début</th>
          <th>Fin</th>
        </tr>
      </thead>
      <tbody>
        <% reservations.forEach(r => { %>
          <tr>
            <td><%= r.catwayNumber %></td>
            <td><%= r.clientName %></td>
            <td><%= r.boatName %></td>
            <td><%= new Date(r.startDate).toLocaleDateString('fr-FR') %></td>
            <td><%= new Date(r.endDate).toLocaleDateString('fr-FR') %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</section>

<%- include('partials/footer') %>
